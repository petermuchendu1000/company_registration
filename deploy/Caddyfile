# Caddy reverse proxy for the operator console.
#
# Install to /etc/caddy/Caddyfile, then: systemctl reload caddy
#
# Caddy rather than nginx + certbot because it obtains and renews Let's
# Encrypt certificates by itself, with no cron job and no manual renewal
# step. For something that has to keep working unattended, that matters
# more than nginx being more familiar.
#
# Naming the host here is what makes HTTPS possible at all: Let's Encrypt
# will not issue a certificate for a bare IP address, so without a hostname
# the only option is plaintext HTTP with the password crossing the internet
# in the clear.

gglabs.tukaze.com {
	encode zstd gzip

	# Security headers.
	header {
		# HSTS deliberately starts SHORT. Once a browser sees this header
		# it refuses plain HTTP for that host for max-age seconds, and
		# there is no way to call it back early. Five minutes is enough to
		# prove the header is being served while leaving an HTTP fallback
		# if certificate issuance turns out to be broken. Raise to
		# 31536000 once the site has been confirmed working over HTTPS.
		Strict-Transport-Security "max-age=300"
		# Raise to this after verification:
		# Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "same-origin"
		-Server
	}

	# The console's upload endpoint caps workbooks at 10 MB and answers 413
	# itself with an explanatory message. Caddy's limit sits just above it so
	# that the application's error is what the operator sees, rather than a
	# bare proxy rejection with no explanation.
	request_body {
		max_size 12MB
	}

	# X-Forwarded-For is deliberately NOT set here.
	#
	# Caddy already discards a client-supplied X-Forwarded-For and
	# substitutes the real peer ("the proxy will ignore their values from
	# incoming requests, to prevent spoofing" -
	# caddyserver.com/docs/caddyfile/directives/reverse_proxy), honouring
	# it only for peers in trusted_proxies. An explicit
	# `header_up X-Forwarded-For {remote_host}` made Caddy warn on every
	# start that it was unnecessary, and a warning nobody can act on
	# trains operators to ignore warnings.
	#
	# This matters because auth._client_ip() reads the FIRST entry of
	# X-Forwarded-For and the login rate limiter buckets by it. If a
	# client-chosen value reached the app, anyone could reset their own
	# bucket on every attempt. Two things keep that shut: Caddy's default
	# above, and auth.py honouring the header only when the immediate peer
	# is loopback - which is exactly this hop.
	#
	# If a CDN is ever placed in front of Caddy, revisit this together
	# with the global trusted_proxies option, or every request will be
	# attributed to the CDN's address.
	reverse_proxy 127.0.0.1:8000

	# Logging goes to journald, which is Caddy's default when no output is
	# named. An earlier version wrote to /var/log/caddy/<host>.log and the
	# service would not start:
	#
	#   open /var/log/caddy/gglabs.tukaze.com.log: permission denied
	#
	# `caddy validate` parses the config, it does not open the file, so the
	# config validated and then died on start. The packaged unit sandboxes
	# the filesystem, so making that path writable means fighting the unit
	# and re-fighting it on upgrade. journalctl -u caddy is where an
	# operator looks anyway:
	#
	#   journalctl -u caddy -f
}
