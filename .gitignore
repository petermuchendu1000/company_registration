# it must never reach the repository.
duns_requests.json
duns_requests.json.lock

# Generated pipeline output (data, not code)
pipeline_output/companies/
pipeline_output/manual_inputs.json
pipeline_output/companies_pipeline.xlsx
pipeline_output/icon_test/
pipeline_output/logs/
pipeline_output/~$*
pipeline_outputlogsserver.log

# Certificates and downloads
certificates/
downloads/

# Browser automation artefacts
.browser_profiles/
debug_screenshots/
.build_log.txt
*.log

# Python artifacts
__pycache__/
*.pyc
.pytest_cache/

# Gradle build
**/build/
.gradle/

# Local gradle properties
apps/template-shift-journal/local.properties

# Editor / OS
.venv/
*.tmp
Thumbs.db
.env
.venv/
__pycache__/

# Local test environments. The container these are built in is ephemeral,
# so they get rebuilt from requirements.lock.txt rather than committed -
# and committing one would put several hundred megabytes of wheels, and
# every binary in them, into the repository.
venv/
venvfresh/
venv313/
