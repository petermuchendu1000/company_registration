# Secrets
.env
# deploy/set_ch_key.sh:82 and deploy/set_ibenty_env.sh:85 back .env up to
# .env.bak.<timestamp> IN THE REPOSITORY ROOT before rewriting it, and the
# same scripts stage the new file as .env.new.XXXXXX. Both are verbatim
# copies of every production credential. Without these two lines they show
# up as untracked, which is one `git add -A` away from being published in
# a public repository - measured: the file is staged, and the secrets scan
# in test_no_committed_secrets.py then reports both keys. That scan is the
# second line of defence; this is the first.
.env.bak.*
.env.new.*
apps/generator/.master_secret
apps/template-shift-journal/app/keystores/
# GENERATED from build.gradle.kts.template on every build, and the block it
# splices in carries each flavor's keystore storePassword and keyPassword as
# plaintext literals (flavor_writer.py). Tracking it put one such password
# in commit 8d0f76f, and made every build dirty the working tree so the next
# `git pull` conflicted against a file nobody had edited.
apps/template-shift-journal/app/build.gradle.kts
# Per-flavor resource overlays, also generated. write_flavor_resources
# rmtree's the directory before rewriting it, and clean_stale_flavors
# rmtree's any flavor missing from the current catalog - so a build for a
# different set of companies DELETED these as tracked files. src/main is
# hand-written and stays tracked; only the c<number> flavor dirs are
# generated.
apps/template-shift-journal/app/src/c*/
pipeline_output/apps/*/signing.json
pipeline_output/apps/*/*.jks

# DUNS request tracking store. Holds company data AND the temp-email
# password in plaintext (duns_automation.py stores it under temp_email), so
# it must never reach the repository.
duns_requests.json
duns_requests.json.lock

# Generated pipeline output (data, not code)
pipeline_output/companies/
pipeline_output/manual_inputs.json
pipeline_output/companies_pipeline.xlsx
pipeline_output/icon_test/
pipeline_output/logs/
pipeline_output/~$*
pipeline_outputlogsserver.log

# Certificates and downloads
certificates/
downloads/

# Browser automation artefacts
.browser_profiles/
debug_screenshots/
.build_log.txt
*.log

# Python artifacts
__pycache__/
*.pyc
.pytest_cache/

# Gradle build
**/build/
.gradle/

# Local gradle properties
apps/template-shift-journal/local.properties

# Editor / OS
.venv/
*.tmp
Thumbs.db
.env
.venv/
__pycache__/

# Local test environments. The container these are built in is ephemeral,
# so they get rebuilt from requirements.lock.txt rather than committed -
# and committing one would put several hundred megabytes of wheels, and
# every binary in them, into the repository.
venv/
venvfresh/
venv313/
