# Configuration for the company app factory.
#
# Copy to .env and fill in. Real environment variables win over this
# file, so a container can override any of it.
#
# Check what you have with:  python config.py check

# ======================================================================
# Core
# ======================================================================

# PostgreSQL connection string. The source of truth for tenants, companies,
# the job registry and the email pool.
# REQUIRED — the app will not start without it.
DATABASE_URL=postgresql://appuser:password@db:5432/company_factory

# Signs session cookies. Changing it logs everyone out; sharing it between
# deployments lets one forge the other's sessions. Generate with: python -c
# 'import secrets;print(secrets.token_urlsafe(48))'
# REQUIRED — the app will not start without it.
FLASK_SECRET_KEY=<48 random url-safe characters>

# Resolves a tenant whenever none is bound, for a single-client deployment.
# Leave unset when more than one tenant uses this instance: it would
# silently answer for a request that failed to bind one.
# SINGLE_TENANT_SLUG=acme

# Where generated files live: certificates, IDs, APKs, AABs. Point it at a
# data volume — it grows with every build and must survive a redeploy.
# PIPELINE_OUTPUT_DIR=/var/lib/company-factory/pipeline_output

# ======================================================================
# Web
# ======================================================================

# Interface to bind. Behind a reverse proxy this stays on loopback; in a
# container it must be 0.0.0.0.
# HOST=127.0.0.1

# Port to bind.
# PORT=5000

# 1 enables the Werkzeug console, which is remote code execution for anyone
# who can reach the port. Local only; the app refuses it on a non-loopback
# host.
# FLASK_DEBUG=0

# 1 marks the session cookie Secure. Set it to 1 wherever the site is served
# over HTTPS.
# SESSION_COOKIE_SECURE=0

# How long a signed-in session lasts.
# SESSION_HOURS=12

# Failed sign-ins allowed per window before lockout.
# LOGIN_MAX_ATTEMPTS=10

# The lockout window, in seconds.
# LOGIN_WINDOW_SECONDS=300

# Largest accepted upload.
# MAX_UPLOAD_MB=25

# ======================================================================
# Companies House
# ======================================================================

# Companies House REST key. Free, from
# developer.company-information.service.gov.uk. Also used to backfill a
# director's date of birth for the ID stage.
# Required for: details, certificate
# COMPANIES_HOUSE_API_KEY=

# ======================================================================
# Namecheap
# ======================================================================

# Namecheap API key.
# Required for: domain, email
# NAMECHEAP_API_KEY=

# Namecheap API user — usually the account name.
# Required for: domain, email
# NAMECHEAP_API_USER=

# Namecheap account username.
# Required for: domain, email
# NAMECHEAP_USERNAME=

# The public IP allow-listed in Namecheap. A call from any other address is
# refused, so this must be the VPS's egress IP, not a developer laptop's.
# Required for: domain, email
# NAMECHEAP_CLIENT_IP=203.0.113.10

# 1 routes every call to sandbox.namecheap.com. Registers nothing and spends
# nothing — use it for any test run.
# NAMECHEAP_SANDBOX=0

# Registration is refused below this account balance, so a batch cannot
# drain the account.
# NAMECHEAP_MIN_BALANCE=15.0

# Registrant address ID used for new registrations. Discovered from the
# account when unset.
# NAMECHEAP_DEFAULT_ADDRESS_ID=

# An existing domain to copy contact details from.
# NAMECHEAP_REFERENCE_DOMAIN=

# ======================================================================
# Director ID
# ======================================================================

# XBINDER account. Without both of these the director_id stage logs SKIP and
# returns, which is harmless: it does not stop the stages after it.
# Required for: director_id
# XBINDER_EMAIL=

# XBINDER password.
# Required for: director_id
# XBINDER_PASSWORD=

# ======================================================================
# Build
# ======================================================================

# Android SDK location. Needs platform-tools, a build-tools release and the
# compile platform.
# Required for: app
# ANDROID_SDK_ROOT=/opt/android-sdk

# JDK 17 or newer, for Gradle.
# Required for: app
# JAVA_HOME=/usr/lib/jvm/java-21-openjdk-amd64

# Gradle builds allowed at once. Each wants a GB or more of heap, so this is
# the main lever on memory. The limit is held in-process, so it only holds
# within one app process.
# MAX_CONCURRENT_BUILDS=1

# ======================================================================
# Publish
# ======================================================================

# Directory of per-company Google Play service account JSON, named
# {company_number}.json. Mount it read-only; these keys can publish to the
# store.
# Required for: publish
# PLAY_SERVICE_ACCOUNTS_DIR=/run/secrets/play_service_accounts

# Data Safety CSV applied to each listing. Without it the Play Console
# section is left for a human.
# PLAY_DATA_SAFETY_TEMPLATE=

